{
  "name": "dogfight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "npm test --workspaces",
    "bench:replay": "npm run bench:replay -w server",
    "demo:loop": "npm run demo:loop -w server"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
