{
  "name": "dogfight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "npm test --workspaces",
    "bench:replay": "npm run bench:replay -w server",
    "demo:loop": "npm run demo:loop -w server",
    "bench:network": "npm run bench:network -w shared",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "typescript": "~5.9.3",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1"
  }
}
